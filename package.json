{
  "name": "qrew",
  "private": true,
  "workspaces": [
    "apps/app"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/app",
    "build": "npm run build -w apps/app",
    "preview": "npm run preview -w apps/app",
    "sync": "npm run sync -w apps/app",
    "ios": "npm run ios -w apps/app",
    "android": "npm run android -w apps/app",
    "deploy:android-emulator": "bash scripts/android-emulator.sh",
    "deploy:android-phone": "bash scripts/android-phone.sh",
    "dev:tunnel": "bash scripts/tunnel.sh --restart",
    "lint": "npm run lint -w apps/app",
    "lint:fix": "npm run lint:fix -w apps/app",
    "format": "npm run format -w apps/app",
    "format:check": "npm run format:check -w apps/app",
    "test": "npm run test -w apps/app",
    "test:run": "npm run test:run -w apps/app",
    "test:file": "npm run test:file -w apps/app --",
    "test:name": "npm run test:name -w apps/app --",
    "test:coverage": "npm run test:coverage -w apps/app",
    "type:check": "npm run type:check -w apps/app"
  }
}
